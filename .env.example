# Discover settings. On the Streamarr server these live in ~/servarr/.env and docker-compose passes them in
# (see the `discover` service). Copy to .env only when running this repo on its own.

# --- required ---
DISCOVER_PASSWORD=change-me            # sign-in password (user below); also derives session + wishlist-feed keys
DISCOVER_USER=karuna
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_KEY=                          # Jellyfin → Dashboard → API Keys → +
TMDB_KEY=                              # themoviedb.org → Settings → API (v3 key or v4 read token)

# --- optional, make picks smarter ---
TRAKT_CLIENT_ID=                       # trakt.tv → Settings → Your API Apps → New; client id only (no login used)
GEMINI_KEY=                            # aistudio.google.com → Get API key (free tier is enough)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- skip already-tracked titles + instant "+ Want" sync ---
SONARR_URL=http://sonarr:8989
SONARR_KEY=                            # Sonarr → Settings → General → API Key
RADARR_URL=http://radarr:7878
RADARR_KEY=                            # Radarr → Settings → General → API Key

# --- misc ---
DISCOVER_REFRESH_HOUR=5                # daily refresh, local time
DISCOVER_SELF_URL=http://discover:5050 # how Sonarr/Radarr reach Discover
DISCOVER_DATA=/data                    # SQLite lives here (mount a volume)
TZ=Asia/Kolkata
